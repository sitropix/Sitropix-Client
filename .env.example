# =============================================================================
# Local portal environment — copy to .env and fill in (never commit .env)
# =============================================================================

# Browser: same-origin /api/... (Vite proxies to the API; see API_SERVER_PORT)
VITE_API_BASE_URL=
# Optional: embed URL for the client Workspace → Project tab (Jira, Linear, Notion, etc.)
VITE_PROJECT_EMBED_URL=
# Optional: only if you add Stripe.js / Elements in the browser
VITE_STRIPE_PUBLISHABLE_KEY=

# API port — must match vite.config.ts proxy and stripe:listen forward URL
# Use 8790 if another app (e.g. Zoho) uses 8787
API_SERVER_PORT=8790
NODE_ENV=development
APP_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8790

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Server-local storage for admin-uploaded client documents (created automatically)
CLIENT_DOCUMENTS_DIR=data/client-documents

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# -----------------------------------------------------------------------------
# Stripe — local dev
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_key_here
# From `npm run stripe:listen` output (local) or Dashboard webhook endpoint (production)
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
STRIPE_SUCCESS_URL=http://127.0.0.1:5173/billing
STRIPE_CANCEL_URL=http://127.0.0.1:5173/subscription

# Option A — auto-create in Stripe from DB plan amounts: npm run stripe:seed-prices
# Option B — paste Dashboard price_... IDs, then: npm run stripe:apply-prices
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=

# Email
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
# Required on the API server before saving SMTP/API keys in Admin → Email (encrypts secrets at rest in DB)
EMAIL_SECRETS_KEY=change_this_to_a_long_random_string_at_least_16_chars

# Security/Audit
AUDIT_LOG_ENABLED=true
