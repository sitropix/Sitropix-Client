# =============================================================================
# Local portal environment — copy to .env and fill in (never commit .env)
# =============================================================================

# Browser: same-origin /api/... (Vite proxies to the API; see API_SERVER_PORT)
VITE_API_BASE_URL=
# Optional: embed URL for the client Workspace → Project tab (Jira, Linear, Notion, etc.)
VITE_PROJECT_EMBED_URL=
# Optional: only if you add Stripe.js / Elements in the browser
VITE_STRIPE_PUBLISHABLE_KEY=

# API port — must match vite.config.ts proxy and stripe:listen forward URL
# Use 8790 if another app (e.g. Zoho) uses 8787
API_SERVER_PORT=8790
NODE_ENV=development
APP_URL=http://127.0.0.1:5173
API_URL=http://127.0.0.1:8790
# Optional comma-separated origins allowed for checkout/billing redirects.
# Leave empty to allow only APP_URL origin.
ALLOWED_REDIRECT_ORIGINS=
# In production, set to 1 to also print structured funnel event lines to stdout (for log drains).
# FUNNEL_LOG_STDOUT=1

# Public lead forms: CSRF on POST /api/forms/.../submit (GET /config returns csrfToken).
# Optional dedicated secret; if unset, a dev-safe derived secret is used (set explicitly in production).
# FORM_CSRF_SECRET=
# Local only: skip CSRF check on public form submit (never enable in production).
# FORM_PUBLIC_CSRF_DISABLED=true

# Cal.com — server fetches booking JSON after embed submit (GET /v2/bookings/:uid). Never commit real keys.
# CAL_API_KEY=cal_live_...
# Optional API version header (default 2024-08-13); see https://cal.com/docs/api-reference/v2/bookings/get-a-booking
# CAL_API_VERSION=2024-08-13

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Prisma Postgres (db.prisma.io): ensure the instance is active in the Prisma console.
# The API adds connect_timeout / pool limits automatically for *.prisma.io hosts.
# If you see intermittent "Can't reach database server", use local Postgres for dev:
# USE_LOCAL_DATABASE=true
# DATABASE_URL_LOCAL=postgresql://postgres:PASSWORD@localhost:5432/postgres
# Optional Prisma pool tuning to reduce DB connection spikes:
# PRISMA_POOL_CONNECTION_LIMIT=5
# PRISMA_POOL_TIMEOUT_SECONDS=30

# Server-local storage for admin-uploaded client documents (created automatically)
CLIENT_DOCUMENTS_DIR=data/client-documents

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=14

# -----------------------------------------------------------------------------
# Stripe — local dev
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your_key_here
# From `npm run stripe:listen` output (local) or Dashboard webhook endpoint (production)
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret
STRIPE_SUCCESS_URL=http://127.0.0.1:5173/billing
STRIPE_CANCEL_URL=http://127.0.0.1:5173/subscription

# Option A — auto-create in Stripe from DB plan amounts: npm run stripe:seed-prices
# Option B — paste Dashboard price_... IDs, then: npm run stripe:apply-prices
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=

# Email — EMAIL_PROVIDER: console | resend | sendgrid | smtp | brevo | mailgun
# "console" logs only (no real delivery). Use resend/sendgrid/smtp + keys for real mail.
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=
SENDGRID_API_KEY=
# SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Brevo (when EMAIL_PROVIDER=brevo)
BREVO_API_KEY=
# Mailgun (when EMAIL_PROVIDER=mailgun)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
# Required on the API server before saving SMTP/API keys in Admin → Email (encrypts secrets at rest in DB)
EMAIL_SECRETS_KEY=change_this_to_a_long_random_string_at_least_16_chars

# Security/Audit
AUDIT_LOG_ENABLED=true

# Observability (API)
# METRICS_BEARER_TOKEN=   # if set, GET /api/metrics requires Authorization: Bearer <token>; in production the route is 404 when unset
# ALERT_WEBHOOK_URL=      # optional JSON POST target for critical alerts (e.g. Stripe webhook handler failure)
# ALERTING_ENABLED=true
# ALERT_ON_INTERNAL_ERROR=false
