{
  "name": "sitropix-support-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c cyan,magenta \"vite --host 127.0.0.1 --port 5173\" \"node server/src/index.mjs\"",
    "dev:vite": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "nodemon server/src/index.mjs",
    "stripe:listen": "node scripts/stripe-listen.mjs",
    "stripe:check-plans": "node scripts/check-stripe-plans.mjs",
    "stripe:apply-prices": "node scripts/apply-stripe-prices.mjs",
    "stripe:seed-prices": "node scripts/seed-stripe-dev-prices.mjs",
    "stripe:sync-catalog": "node scripts/sync-plan-stripe-catalog.mjs",
    "db:ping": "node scripts/ping-db.mjs",
    "db:flush:billing": "node scripts/db-flush-billing-core.mjs",
    "db:seed:catalog": "node scripts/db-seed-catalog.mjs",
    "db:sync:extra-edit-addons": "node scripts/db-sync-extra-edit-addons.mjs",
    "db:push:stripe-plans": "node scripts/db-push-stripe-plan-ids.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "6.19.0",
    "@tiptap/extension-link": "^3.22.4",
    "@tiptap/extension-placeholder": "^3.22.4",
    "@tiptap/extension-underline": "^3.22.4",
    "@tiptap/pm": "^3.22.4",
    "@tiptap/react": "^3.22.4",
    "@tiptap/starter-kit": "^3.22.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "resend": "^6.12.2",
    "stripe": "^22.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prisma": "6.19.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.5"
  }
